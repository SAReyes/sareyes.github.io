---
import SocialLinks from './SocialLinks.astro';
---

<section id="contact" class="mx-auto w-full max-w-5xl scroll-mt-24 px-6 py-14">
	<div class="rounded-xl border border-neutral-800 bg-neutral-900/40 p-8">
		<h2 class="text-2xl font-bold text-white md:text-3xl">Contact</h2>
		<p class="mt-4 max-w-2xl text-neutral-300">
			Open to discussing product engineering, platform work, and technical leadership opportunities.
			The fastest way to reach me is through these channels.
		</p>
		<div class="mt-7">
			<SocialLinks variant="button" labelStyle="handles" />
		</div>
	</div>
</section>
