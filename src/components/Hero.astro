---
import SocialLinks from './SocialLinks.astro';
---

<section id="top" class="mx-auto w-full max-w-5xl px-6 pb-16 pt-20 md:pt-24">
	<p class="mb-4 text-sm font-medium uppercase tracking-[0.2em] text-cyan-300">Lead Full Stack Engineer</p>
	<h1 class="max-w-3xl text-4xl font-extrabold leading-tight text-white md:text-6xl">
		Adrian Reyes
	</h1>
	<p class="mt-6 max-w-2xl text-base leading-relaxed text-neutral-300 md:text-lg">
		Full stack engineer building products end-to-end — from ML models and native apps to
		cloud-native platforms that scale with teams, traffic, and complexity.
	</p>

	<div class="mt-8 text-sm">
		<SocialLinks variant="button" labelStyle="short" />
	</div>
</section>
