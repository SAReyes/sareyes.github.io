---
const experiences = [
	{
		role: 'Lead Full Stack Engineer',
		company: 'Paired (Better Half Ltd.)',
		period: '2022 - Present',
		description:
			'Lead full stack engineer responsible for building and maintaining the core platform and special projects like ML models and native development.'
	},
	{
		role: 'Senior Full Stack Engineer',
		company: 'Plain Concepts',
		period: '2019 - 2022',
		description:
			'Consulted and led solo projects involving large-scale single page applications, personalized 1-to-1 engineering support, and deploying TensorFlow models at scale for diverse clients and use cases.'
	},
	{
		role: 'Software Engineer',
		company: 'Adidas',
		period: '2018 - 2019',
		description:
			'Led and managed cross-functional projects leveraging the company\'s CMS platform to deliver scalable business solutions.'
	}
];
---

<section id="experience" class="mx-auto w-full max-w-5xl scroll-mt-24 px-6 py-14">
	<h2 class="text-2xl font-bold text-white md:text-3xl">Experience</h2>
	<p class="mt-2 text-sm text-neutral-400">Building software professionally since 2015.</p>
	<div class="mt-8 space-y-8 border-l border-neutral-800 pl-6">
		{
			experiences.map((item) => (
				<article class="relative">
					<span class="absolute -left-[31px] top-1.5 h-3 w-3 rounded-full bg-cyan-300"></span>
					<p class="text-xs font-semibold uppercase tracking-wider text-cyan-300">{item.period}</p>
					<h3 class="mt-2 text-lg font-semibold text-white">
						{item.role}
						<span class="font-medium text-neutral-400"> - {item.company}</span>
					</h3>
					<p class="mt-2 leading-relaxed text-neutral-300">{item.description}</p>
				</article>
			))
		}
		<article class="relative">
			<span class="absolute -left-[31px] h-3 w-3 rounded-full bg-cyan-300"></span>
			<p class="text-xs font-semibold uppercase tracking-wider text-cyan-300">Since 2015</p>
		</article>
	</div>
</section>
