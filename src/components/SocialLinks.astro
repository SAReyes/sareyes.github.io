---
import { siGithub, siKofi } from 'simple-icons';

const GITHUB_URL = 'https://github.com/SAReyes';
const TWITTER_URL = 'https://twitter.com/SAReyes_';
const KOFI_URL = 'https://ko-fi.com/areyes';

/** Legacy bird mark; `simple-icons` only provides X for that brand now. */
const TWITTER_ICON_PATH =
	'M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z';

interface Props {
	variant?: 'button' | 'inline';
	/** 'short' shows GitHub / Twitter / Ko-fi; 'handles' shows site-style URLs */
	labelStyle?: 'short' | 'handles';
	class?: string;
}

const {
	variant = 'button',
	labelStyle = 'short',
	class: className = ''
} = Astro.props;

const buttonBaseClass =
	'inline-flex items-center gap-2 rounded-md border border-neutral-700 px-4 py-2 text-sm text-neutral-100 transition hover:border-cyan-400 hover:text-cyan-300';

const inlineClass =
	'inline-flex items-center gap-1.5 text-cyan-300 underline-offset-4 transition hover:text-cyan-200 hover:underline';

const iconSvgClass = 'size-4 shrink-0';
---

<div class:list={['flex flex-wrap items-center gap-4', className]}>
	<a
		href={GITHUB_URL}
		target="_blank"
		rel="noopener noreferrer"
		class:list={[variant === 'button' ? buttonBaseClass : inlineClass]}
	>
		<svg class={iconSvgClass} viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
			<path fill="currentColor" d={siGithub.path} />
		</svg>
		{labelStyle === 'short' ? 'GitHub' : 'github.com/SAReyes'}
	</a>
	<a
		href={TWITTER_URL}
		target="_blank"
		rel="noopener noreferrer"
		class:list={[variant === 'button' ? buttonBaseClass : inlineClass]}
	>
		<svg class={iconSvgClass} viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
			<path fill="currentColor" d={TWITTER_ICON_PATH} />
		</svg>
		{labelStyle === 'short' ? 'Twitter' : 'twitter.com/SAReyes_'}
	</a>
	<a
		href={KOFI_URL}
		target="_blank"
		rel="noopener noreferrer"
		class:list={[variant === 'button' ? buttonBaseClass : inlineClass]}
	>
		<svg class={iconSvgClass} viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
			<path fill="currentColor" d={siKofi.path} />
		</svg>
		{labelStyle === 'short' ? 'Ko-fi' : 'ko-fi.com/areyes'}
	</a>
</div>
