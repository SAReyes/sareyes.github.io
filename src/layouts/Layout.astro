---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = 'Adrian Reyes - Lead Engineer',
	description = 'Lead Engineer crafting reliable, scalable products with strong developer experience and clean architecture.',
	image = '/favicon-32.svg'
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon-32.png" sizes="32x32"/>
		<link rel="icon" href="/favicon-16.png" sizes="16x16"/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>

		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0a0a0a" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="areyes.es" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />

		<title>{title}</title>
	</head>
	<body class="bg-neutral-950 font-sans text-neutral-100 antialiased">
		<slot />
	</body>
</html>
