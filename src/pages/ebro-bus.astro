---
import Footer from '../components/Footer.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Layout from '../layouts/Layout.astro';

const screenshots = [
	{
		src: '/ebro-bus/iphone-screenshot-1.jpg',
		alt: 'Ebro Bus home screen showing saved stops and next arrivals',
		label: 'Inicio'
	},
	{
		src: '/ebro-bus/iphone-screenshot-2.jpg',
		alt: 'Ebro Bus map with route and stop arrivals',
		label: 'Mapa'
	},
	{
		src: '/ebro-bus/iphone-screenshot-3.jpg',
		alt: 'Ebro Bus favorites screen with grouped stops',
		label: 'Favoritos'
	},
	{
		src: '/ebro-bus/iphone-screenshot-4.jpg',
		alt: 'Ebro Bus Live Activity screen showing bus arrival times',
		label: 'Live Activity'
	},
	{
		src: '/ebro-bus/iphone-screenshot-5.jpg',
		alt: 'Ebro Bus Dynamic Island screen showing bus arrival times',
		label: 'Dynamic Island'
	}
];
---

<Layout
	title="Ebro Bus — Bus times in Zaragoza"
	description="Real-time bus waiting times for Zaragoza using open data. Free on the App Store (coming soon)."
	image="/ebro-bus/ebrobus-icon-512.png"
>
	<main>
		<section class="mx-auto w-full max-w-5xl px-6 pb-12 pt-16 md:pb-16 md:pt-20">
			<div class="flex flex-col items-start gap-8 md:flex-row md:items-center md:gap-10">
				<img
					src="/ebro-bus/ebrobus-icon-512.png"
					alt=""
					width="128"
					height="128"
					class="h-24 w-24 shrink-0 rounded-[22%] shadow-lg shadow-black/40 ring-1 ring-white/10 md:h-32 md:w-32"
				/>
				<div class="min-w-0 flex-1">
					<p class="text-sm font-medium uppercase tracking-[0.2em] text-cyan-300">iOS app</p>
					<h1 class="mt-2 text-3xl font-extrabold text-white md:text-5xl">Ebro Bus</h1>
					<p class="mt-4 max-w-2xl text-base leading-relaxed text-neutral-300 md:text-lg">
						See real-time bus arrivals across Zaragoza. Built on the city&apos;s open transport data with a
						fast, modern interface — home, map, and favorites in one place.
					</p>
					<div class="mt-8 flex flex-wrap items-center gap-3">
						<a
							href="https://apps.apple.com/"
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center rounded-md border border-neutral-600 px-4 py-2 text-sm text-neutral-400 transition hover:border-neutral-500 hover:text-neutral-300"
							title="App Store listing will be linked here when the app is published"
						>
							App Store
							<span
								class="ml-2 rounded-full border border-neutral-700 bg-neutral-900 px-2 py-0.5 text-xs text-neutral-500"
							>
								Coming soon
							</span>
						</a>
						<a
							href="#privacy"
							class="inline-flex items-center rounded-md border border-neutral-700 px-4 py-2 text-sm text-neutral-100 transition hover:border-cyan-400 hover:text-cyan-300"
						>
							Privacy Policy
						</a>
					</div>
				</div>
			</div>
		</section>

		<section class="border-t border-neutral-800/80 bg-neutral-900/20 py-14 md:py-16" aria-labelledby="screenshots-heading">
			<div class="mx-auto w-full max-w-5xl px-6">
				<h2 id="screenshots-heading" class="text-2xl font-bold text-white md:text-3xl">Screenshots</h2>
				<p class="mt-2 max-w-2xl text-sm text-neutral-400">
					Dark mode UI tuned for quick glances at the next bus.
				</p>

				<div
					class="mt-10 flex flex-nowrap snap-x snap-mandatory gap-6 overflow-x-auto overscroll-x-contain scroll-pl-6 scroll-pr-6 pb-4 [scrollbar-width:thin] [-webkit-overflow-scrolling:touch]"
				>
					{
						screenshots.map(({ src, alt, label }) => (
							<figure class="w-[min(280px,85vw)] shrink-0 snap-center md:w-72">
								<div class="overflow-hidden rounded-[2rem] border border-neutral-800 bg-neutral-950 shadow-xl shadow-black/50 ring-1 ring-white/5">
									<img src={src} alt={alt} class="block w-full" loading="lazy" decoding="async" />
								</div>
								<figcaption class="mt-3 text-center text-sm font-medium text-neutral-400">{label}</figcaption>
							</figure>
						))
					}
				</div>
			</div>
		</section>

		<section id="privacy" class="mx-auto w-full max-w-5xl scroll-mt-8 px-6 py-16 md:py-24">
			<div class="rounded-xl border border-neutral-800 bg-neutral-900/40 p-8 md:p-10">
				<h2 class="text-2xl font-bold text-white md:text-3xl">Privacy Policy</h2>

				<div class="mt-8 max-w-2xl space-y-6 text-neutral-300 leading-relaxed">
					<p>This app does not collect, store, or share any personal data.</p>
					<p>
						The application uses publicly available transport data from Zaragoza&apos;s open data services to
						display bus waiting times.
					</p>
					<p>No user accounts, tracking, analytics, or personal identifiers are used.</p>
					<p>
						If you have any questions, contact:
						<span class="mt-3 block">
							<SocialLinks variant="inline" />
						</span>
					</p>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
